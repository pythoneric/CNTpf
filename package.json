{
  "name": "cntpf",
  "version": "1.0.0",
  "description": "> Dashboard financiero personal construido como PWA (Progressive Web App). Funciona en móvil, tablet y PC. Tus datos nunca salen de tu dispositivo.",
  "main": "sw.js",
  "scripts": {
    "start": "serve . -l 8080 --no-clipboard",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "build:www": "node scripts/build-www.mjs",
    "android:sync": "npm run build:www && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pythoneric/CNTpf.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pythoneric/CNTpf/issues"
  },
  "homepage": "https://github.com/pythoneric/CNTpf#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "playwright": "^1.58.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@playwright/test": "^1.58.2",
    "chart.js": "4.4.1",
    "serve": "^14.2.6"
  }
}
